# Mosaic Life - Local Development Environment Variables
# Copy this file to .env and customize as needed
# Default values are provided for local development

# ============================================================================
# Application Environment
# ============================================================================
ENV=dev
LOG_LEVEL=info

# ============================================================================
# Application URLs
# ============================================================================
# Frontend URL (where the React app runs)
APP_URL=http://localhost:5173

# Backend API URL (where the Core API runs)
API_URL=http://localhost:8080

# For external/network access, update both URLs to your hostname:
# APP_URL=http://your-hostname:5173
# API_URL=http://your-hostname:8080

# ============================================================================
# Session Configuration
# ============================================================================
# Secret key for signing session cookies
# IMPORTANT: Generate a strong secret for production!
# You can generate one with: openssl rand -base64 32
SESSION_SECRET_KEY=dev-secret-change-in-production

# Session expiry in seconds (default: 7 days = 604800 seconds)
# Common values:
#   24 hours = 86400
#   7 days = 604800
#   30 days = 2592000
# SESSION_COOKIE_MAX_AGE=604800

# ============================================================================
# Authentication Provider
# ============================================================================
# Default for local development: "keycloak" (works fully offline)
# Set to "google" only if you have a Google OAuth client configured below.
AUTH_PROVIDER=keycloak

# ============================================================================
# Keycloak OIDC Configuration (used when AUTH_PROVIDER=keycloak)
# ============================================================================
# Client ID registered in the Keycloak mosaic realm
KEYCLOAK_CLIENT_ID=mosaic-life

# Client secret — copy from your Keycloak realm client settings
# (Clients → mosaic-life → Credentials → Client Secret)
KEYCLOAK_CLIENT_SECRET=change-me

# OIDC discovery URL for the mosaic realm (public hostname)
KEYCLOAK_DISCOVERY_URL=http://localhost:8180/realms/mosaic/.well-known/openid-configuration

# Internal URL for server-to-server calls from inside Docker.
# Must point to the Keycloak service name on the Docker network.
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080

# ============================================================================
# Google OAuth Configuration (used when AUTH_PROVIDER=google)
# ============================================================================
# NEVER commit real values here — store them only in your local .env file.
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Steps:
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:8080/api/auth/google/callback
#    (or http://your-hostname:8080/api/auth/google/callback for external access)
# 3. Add authorized JavaScript origin: http://localhost:5173
#    (or http://your-hostname:5173 for external access)
# Secrets in production are read from AWS Secrets Manager (mosaic/prod/google-oauth)
#GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-client-secret


# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mosaic

# Database URL for core-api service
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DB_URL=postgresql+psycopg://postgres:postgres@postgres:5432/mosaic

# ============================================================================
# Storage Configuration (for media uploads)
# ============================================================================
# Storage backend: "local" for development, "s3" for production
STORAGE_BACKEND=local

# Local storage path (used when STORAGE_BACKEND=local)
LOCAL_MEDIA_PATH=/app/media

# ============================================================================
# AWS S3 Configuration (for production media uploads)
# ============================================================================
# Used when STORAGE_BACKEND=s3
# Make sure AWS credentials are configured (~/.aws/credentials or env vars)
S3_MEDIA_BUCKET=mosaic-life-media-dev
AWS_REGION=us-east-1

# ============================================================================
# Frontend Configuration
# ============================================================================
# API URL for the web app (accessible from browser)
VITE_API_URL=http://localhost:8080

# Backend URL for Vite proxy
# For localhost: http://core-api:8080 (Docker internal network)
# For external access: http://your-hostname:8080
VITE_BACKEND_URL=http://core-api:8080

# ============================================================================
# PostgreSQL Configuration (for postgres service)
# ============================================================================
# Internal Postgres data directory path
PGDATA=/var/lib/postgresql/data/pgdata

# ============================================================================
# LiteLLM Configuration
# ============================================================================
# LiteLLM proxy URL (for AI model routing)
LITELLM_BASE_URL=http://litellm:4000
